<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 지도를 띄울 컨테이너 -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RelativeLayout
        android:id="@+id/header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="4dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_centerVertical="true"
            android:text="대기 장소 추천"
            android:fontFamily="@font/f_extrabold"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textColor="#1E40AF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_back_home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:background="@drawable/round_sky_button"
            android:src="@drawable/ic_home"
            android:contentDescription="홈으로"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- 줌 인/아웃 버튼 그룹 -->
    <LinearLayout
        android:id="@+id/zoom_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btn_zoom_in"
            android:background="@drawable/round_sky_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_add"
            android:contentDescription="Zoom In"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/btn_zoom_out"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/round_sky_button"
            android:src="@drawable/ic_remove"
            android:contentDescription="Zoom Out"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- ← 이 부분을 추가했습니다. 줌 컨트롤 바로 위에 배치 -->
    <ImageButton
        android:id="@+id/btn_gps"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:background="@null"
        android:src="@drawable/gps"
        android:scaleType="centerInside"
        android:contentDescription="GPS"
        app:layout_constraintEnd_toEndOf="@id/zoom_control"
        app:layout_constraintBottom_toTopOf="@id/zoom_control" />

</androidx.constraintlayout.widget.ConstraintLayout>
