<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 상단 경로 설명 -->
    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 경로 정보 및 버튼을 포함하는 수평 레이아웃 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 출발지 → 도착지 텍스트 -->
            <TextView
                android:id="@+id/map_header_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="출발지 → 도착지"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <!-- 안내 시작 버튼 -->
            <Button
                android:id="@+id/btn_start_navi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="목적지로 안내"
                android:backgroundTint="#549BFF"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />

            <!-- 안내 종료 버튼 -->
            <Button
                android:id="@+id/btn_stop_navi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="안내 종료"
                android:backgroundTint="#549BFF"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 🚗 방향 안내 배너 -->
        <TextView
            android:id="@+id/text_direction_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#3366cc"
            android:textColor="#FFFFFF"
            android:text="안내 텍스트"
            android:padding="8dp"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- 지도 영역 -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/info_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 도착 안내 오버레이 (메시지 + 버튼) -->
    <LinearLayout
        android:id="@+id/arrival_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CCFFFFFF"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/arrival_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="도착 메시지"
            android:textSize="18sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/arrival_action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="다음 단계"
            android:backgroundTint="#549BFF"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- 확대/축소 버튼 -->
    <LinearLayout
        android:id="@+id/zoom_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_zoom_in"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/round_sky_button"
            android:src="@drawable/ic_add"
            android:contentDescription="확대" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="12dp" />

        <ImageButton
            android:id="@+id/btn_zoom_out"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/round_sky_button"
            android:src="@drawable/ic_remove"
            android:contentDescription="축소" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_gps"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:background="@null"
        android:src="@drawable/gps"
        android:scaleType="centerInside"
        android:contentDescription="GPS"
        app:layout_constraintEnd_toEndOf="@id/zoom_control"
        app:layout_constraintBottom_toTopOf="@id/zoom_control"/>

</androidx.constraintlayout.widget.ConstraintLayout>
